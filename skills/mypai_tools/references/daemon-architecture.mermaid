flowchart TD
    %% Ingress & Producers Layer
    subgraph IngressLayer ["Ingress & Event Producers"]
        WEBUI["WebUI Console & REST API<br/>(Port 52080 / ws://api/v1/ws)"]
        SIGNAL["Signal Webhook Gateway<br/>(SignalClient & Whitelist Filter)"]
        SPOOLER["Input Spooler Daemon<br/>(Inbox Watcher, STT, Hindsight)"]
    end

    %% Tier 1: Parallel Background Execution Plane
    subgraph Tier1 ["Tier 1: Parallel Background Execution Plane"]
        SCHEDULER["CronScheduler Engine<br/>(APScheduler Core)"]
        REGISTRY["running_jobs Concurrency Registry<br/>(Active Tasks & Duplicate Run Prevention)"]
        
        subgraph Executors ["Parallel Job Executors"]
            EXEC_SHELL["Shell Executor<br/>(env injection, timeout)"]
            EXEC_HTTP["HTTP Executor<br/>(verbs, headers, timeout)"]
            EXEC_PY["Python Executor<br/>(in-process lambda/code)"]
            EXEC_ACP["ACP Subagents<br/>(pure async workers)"]
        end
        
        RESULT_EVAL["Result & Error Evaluation<br/>(Macro Expansion & Lineage Tagging)"]
    end

    %% Tier 2: Serialized OMP Turn Queue Plane
    subgraph Tier2 ["Tier 2: Serialized OMP RPC Turn Queue Plane"]
        TURN_QUEUE["TurnQueue (Priority-Flush State Machine)<br/>(Rule 1: Abort Purge | Rule 2: Steer | Rule 3: Followup | Rule 4: Idle Prompt)"]
        WORKER_LOOP["queue_worker_loop<br/>(Async Worker Coroutine)"]
    end

    %% Execution & Persistent Session Layer
    subgraph SessionLayer ["Persistent OMP RPC Session & Host Tools"]
        SESS_MGR["OMPSessionManager<br/>(UUID Reattachment & Telemetry)"]
        RPC_CLIENT["RpcClient Subprocess<br/>(omp --mode rpc --profile mypai)"]
        
        subgraph HostTools ["Native Host Tools (In-Process)"]
            CRON_TOOLS["Cron Host Tools<br/>(add_job, run_once, list_jobs, etc.)"]
            ACP_TOOLS["ACP Host Tools<br/>(acp_task_async, status, result, steer)"]
        end
    end

    %% Persistence & Telemetry Layer
    subgraph StorageLayer ["Persistence & Telemetry"]
        SQLITE["SQLite Database (WAL Mode)<br/>(agent-{basedir}-{hash}.db)"]
        WS_STREAM["WebSocket Broadcast Stream<br/>(turn_started, turn_completed, etc.)"]
    end

    %% Ingress Flow
    WEBUI -->|"Turns: prompt, steer, followup, abort"| TURN_QUEUE
    SIGNAL -->|"Verified Inbound Messages"| TURN_QUEUE
    SPOOLER -->|"Transcribed Audio Prompts"| TURN_QUEUE
    
    %% Tier 1 Execution Flow
    SQLITE <-->|"Sync Jobs & Telemetry"| SCHEDULER
    SCHEDULER -->|"Check Job ID"| REGISTRY
    REGISTRY -->|"Spawn Async Task"| Executors
    Executors -->|"Output / Error / Exitcode"| RESULT_EVAL
    RESULT_EVAL -->|"is_result_call=True (mode != log)"| TURN_QUEUE
    
    %% Tier 2 Serialization Flow
    TURN_QUEUE -->|"get_next(is_session_busy)"| WORKER_LOOP
    WORKER_LOOP -->|"Execute Serialized Turn"| SESS_MGR
    SESS_MGR -->|"Manage Connection"| RPC_CLIENT
    
    %% Host Tools & Subprocess Binding
    RPC_CLIENT -->|"Register Host Tools"| HostTools
    CRON_TOOLS <-->|"Direct DB Queries"| SQLITE
    ACP_TOOLS <-->|"Delegate Async Tasks"| EXEC_ACP
    
    %% Streaming & Telemetry
    RPC_CLIENT -->|"Stream Chunks & Events"| SESS_MGR
    SESS_MGR -->|"Broadcast"| WS_STREAM
    WS_STREAM -->|"Live Updates"| WEBUI
    WORKER_LOOP -->|"Record History"| SQLITE
