flowchart TD
    %% Ingress & Producers Layer
    subgraph Producers ["Multiproducer Inputs & Ingress"]
        REST["REST API Server<br/>(FastAPI / Uvicorn)"]
        WEBUI["WebUI / WebSocket<br/>(/api/v1/ws)"]
        SIGNAL["Signal Webhook & Gateway<br/>(SignalClient)"]
        CRON["Cron Scheduler<br/>(APScheduler Engine)"]
        SPOOLER["Input Spooler<br/>(File Ingestion & STT)"]
        EXEC_RES["Job Executors<br/>(Python, Shell, HTTP, RPC)"]
    end

    %% Priority Event Queue Layer
    subgraph QueueLayer ["EventQueue (MPSC Priority Queue)"]
        P0["Priority 0: High-Priority Interrupts<br/>(steer, abort, abort_retry, abort_and_prompt, ui_interaction)"]
        P1["Priority 1: Interactive Human Inputs<br/>(webui, signal)"]
        P2["Priority 2: Automated Background Tasks<br/>(cron, spooler, executor_result)"]
        HISTORY["Execution History & Telemetry<br/>(last 100 turns)"]
    end

    %% Worker Loop Layer
    subgraph WorkerLayer ["Asynchronous Queue Worker Loop"]
        WORKER["queue_worker_loop<br/>(Async Coroutine)"]
        INTERRUPT_DISPATCH["P0 Immediate Interrupt Dispatcher"]
    end

    %% Session Manager & Core RPC Layer
    subgraph SessionLayer ["OMPSessionManager & Persistent Connection"]
        SESS_MGR["OMPSessionManager<br/>(Session UUID Persistence in SQLite)"]
        CLIENT["RpcClient Subprocess<br/>(omp --mode rpc --profile mypai)"]
        LISTENERS["RPC Event Listeners<br/>(on_turn_end, on_turn_start, on_agent_end)"]
        EVENT_SIGNAL["_turn_done_event<br/>(asyncio.Event Signal)"]
        ACP_TOOLS["ACP Host Tools & Headless UI"]
    end

    %% Data Flow & Interconnections
    REST -->|"POST /session/prompt, steer, abort"| QueueLayer
    WEBUI -->|"User Prompts & Steer Commands"| QueueLayer
    SIGNAL -->|"Incoming Messages"| QueueLayer
    CRON -->|"Scheduled OMP Tasks"| QueueLayer
    SPOOLER -->|"Ingested Content Prompts"| QueueLayer
    EXEC_RES -->|"result_action Dispatches"| QueueLayer

    QueueLayer -->|get_next| WORKER

    WORKER -->|"P1/P2 Non-blocking Turn Dispatch"| SESS_MGR
    WORKER -->|"P0 Immediate Interrupts (steer/abort)"| INTERRUPT_DISPATCH
    INTERRUPT_DISPATCH -->|"Direct RPC Call (Bypasses Lock)"| CLIENT

    SESS_MGR -->|"Persistent RPC Connection"| CLIENT
    CLIENT -->|"Live Streaming & Turn Events"| LISTENERS
    LISTENERS -->|"Set Signal"| EVENT_SIGNAL
    LISTENERS -->|"Broadcast Events"| WEBUI
    EVENT_SIGNAL -->|"Unblocks await execute_turn"| WORKER
    CLIENT -->|"Register Tools"| ACP_TOOLS

    REST -.->"Direct Inspection Calls<br/>(get_state, get_stats)"| SESS_MGR
