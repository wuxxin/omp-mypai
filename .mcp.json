{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "chat-channel": {
      "type": "stdio",
      "command": "./.plugin-venv/bin/python3",
      "args": ["-m", "mypai_tools.chat_mcp"]
    },
    "cron-scheduler": {
      "type": "stdio",
      "command": "./.plugin-venv/bin/python3",
      "args": ["-m", "mypai_tools.cron_mcp"]
    }
  }
}
